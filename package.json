{
  "name": "quietpages-astro-theme",
  "description": "A free Astro magazine theme for essays, field notes, and long-form writing, with an aurora hero, a filterable archive, a search palette, and light and dark modes.",
  "type": "module",
  "version": "3.0.1",
  "author": "Andrei Alba",
  "license": "MIT",
  "private": true,
  "keywords": [
    "astro-theme",
    "astro",
    "blog",
    "magazine",
    "editorial",
    "writing",
    "essays",
    "mdx",
    "tailwindcss"
  ],
  "homepage": "https://quietpages.xocoweb.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xocothemes/quietpages.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "release:check": "npm run check && npm run build && npm run format:check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
