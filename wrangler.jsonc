{
  "name": "diaryfromtheroad",
  "compatibility_date": "2026-10-08",
  // Every push to `main` deploys through Cloudflare Workers Builds; by hand, `npm run build`, then
  // `npx wrangler deploy`, which uses the Worker config the build writes.
  // The site answers only on diaryfromtheroad.com, a custom domain attached in the dashboard (Settings →
  // Domains & Routes), which deploys leave as it is. The workers.dev URL and preview URLs are off.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Email subscribers (SUBSCRIPTIONS.md). Sign-up also needs `subscriptions.enabled` in src/config/site.ts.
  // Local development (`astro dev`, `--local` commands) uses a local copy in .wrangler/, never this database.
  "d1_databases": [
    {
      "binding": "SUBSCRIBERS_DB",
      "database_name": "diary-subscribers",
      "database_id": "13b89fc3-a391-4df1-b5c2-0b6ad426cc9b",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // The sender for confirmation emails, on diaryfromtheroad.com, which is verified in Resend.
    // Secrets (TURNSTILE_SECRET_KEY, RESEND_API_KEY) are set with `wrangler secret put`, never here.
    "EMAIL_FROM": "Diary From the Road <hello@diaryfromtheroad.com>",
    // Gets a short email whenever someone confirms. Empty turns the notes off.
    "NOTIFY_EMAIL": "hello@diaryfromtheroad.com",
  },
}
