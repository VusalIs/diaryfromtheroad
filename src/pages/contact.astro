---
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBreadcrumbs } from "@/lib/schema";

const crumbs = [{ label: "Home", href: "/" }, { label: "Contact" }];
/* Instagram comes from `socials` in src/config/site.ts; the handle is its profile URL's path. */
const instagram = siteConfig.socials.find((social) => social.icon === "instagram");
const handle = instagram && new URL(instagram.href).pathname.split("/").filter(Boolean)[0];
const elsewhere = siteConfig.socials.filter((social) => social !== instagram);
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${siteConfig.name}.`}
  structuredData={withBreadcrumbs({ "@type": "ContactPage", name: "Contact" }, crumbs)}
>
  <PageHeader
    title="Say hello."
    lead={instagram ? "You can reach me on Instagram." : undefined}
    crumbs={crumbs}
  />

  <div class="shell">
    {instagram && (
      <a href={instagram.href} class="group inline-flex items-center gap-4">
        <Icon name="social-instagram" class="size-8 shrink-0" />
        <span class="serif text-section font-normal">
          <span class="card-title">@{handle}</span>
          <span class="sr-only"> on Instagram</span>
        </span>
      </a>
    )}

    <div class:list={["space-y-10", instagram && "mt-16"]}>
      {siteConfig.email && (
        <div>
          <h2 class="serif text-2xl">Email</h2>
          <a
            href={`mailto:${siteConfig.email}`}
            class="text-link mt-3 inline-flex items-center gap-2"
          >
            <Icon name="mail" class="size-4" />
            {siteConfig.email}
          </a>
        </div>
      )}
      <div>
        <h2 class="serif text-2xl">Elsewhere</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {elsewhere.map((social) => (
            <li>
              <a href={social.href} class="chip">
                <Icon name={`social-${social.icon}`} class="size-3.5" />
                {social.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/rss.xml" class="chip">
              <Icon name="rss" class="size-3.5" />
              RSS
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>
