---
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBreadcrumbs } from "@/lib/schema";

const endpoint = siteConfig.forms.contact;
const crumbs = [{ label: "Home", href: "/" }, { label: "Contact" }];
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${siteConfig.name}.`}
  structuredData={withBreadcrumbs({ "@type": "ContactPage", name: "Contact" }, crumbs)}
>
  <PageHeader title="Say hello." crumbs={crumbs} />

  <div class="shell grid gap-14 lg:grid-cols-[minmax(0,1.5fr)_1fr] lg:gap-24">
    <form
      class="grid gap-6 rounded-panel border border-line bg-surface p-6 sm:grid-cols-2 sm:p-10"
      method="post"
      action={endpoint || undefined}
      data-demo-form={endpoint ? undefined : ""}
      data-needs-js={endpoint ? undefined : ""}
      data-success="Thanks, your note is on its way (demo mode: set an endpoint in src/config/site.ts to receive messages)."
    >
      <div>
        <label for="contact-name" class="label">
          Name
        </label>
        <input id="contact-name" name="name" autocomplete="name" required class="field" />
      </div>
      <div>
        <label for="contact-email" class="label">
          Email
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          class="field"
        />
      </div>
      <div class="sm:col-span-2">
        <label for="contact-topic" class="label">
          Topic
        </label>
        <div class="relative">
          <select id="contact-topic" name="topic" class="field appearance-none pr-10">
            <option>A note or a question</option>
            <option>A correction</option>
          </select>
          <Icon
            name="chevron-down"
            class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-muted"
          />
        </div>
      </div>
      <div class="sm:col-span-2">
        <label for="contact-message" class="label">
          Message
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="6"
          required
          class="field resize-y"
        ></textarea>
      </div>
      <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center">
        <button type="submit" class="btn btn-primary">
          Send message
        </button>
        <p class="text-sm text-muted" data-form-status role="status"></p>
      </div>
    </form>

    <aside class="space-y-10">
      {siteConfig.email && (
        <div>
          <h2 class="serif text-2xl">Email</h2>
          <a
            href={`mailto:${siteConfig.email}`}
            class="text-link mt-3 inline-flex items-center gap-2"
          >
            <Icon name="mail" class="size-4" />
            {siteConfig.email}
          </a>
        </div>
      )}
      <div>
        <h2 class="serif text-2xl">Elsewhere</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {siteConfig.socials.map((social) => (
            <li>
              <a href={social.href} class="chip">
                <Icon name={`social-${social.icon}`} class="size-3.5" />
                {social.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/rss.xml" class="chip">
              <Icon name="rss" class="size-3.5" />
              RSS
            </a>
          </li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  import "@/scripts/forms";
</script>
