---
import PostGrid from "@/components/blog/PostGrid.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { categories, type Category } from "@/config/taxonomy";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryUrl, getPosts, plural } from "@/lib/posts";
import { absolute, withBreadcrumbs } from "@/lib/schema";

export async function getStaticPaths() {
  const posts = await getPosts();
  return categories
    .filter((category) => posts.some((post) => post.category === category.slug))
    .map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const posts = (await getPosts()).filter((post) => post.category === category.slug);
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Topics", href: "/categories/" },
  { label: category.name },
];
---

<BaseLayout
  title={category.name}
  description={`${category.description} ${plural(posts.length, "post")} in ${category.name}.`}
  structuredData={withBreadcrumbs(
    {
      "@type": "CollectionPage",
      name: category.name,
      description: category.description,
      url: absolute(categoryUrl(category.slug)),
    },
    crumbs,
  )}
>
  <PageHeader title={category.name} lead={category.description} crumbs={crumbs}>
    <p class="rise mt-6 text-sm text-muted" style="--rise-order: 3">
      {plural(posts.length, "post")}
    </p>
  </PageHeader>
  <PostGrid posts={posts} />
</BaseLayout>
