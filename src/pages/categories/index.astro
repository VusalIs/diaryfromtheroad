---
import SectionIndex from "@/components/home/SectionIndex.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { countBy, getPosts } from "@/lib/posts";
import { withBreadcrumbs } from "@/lib/schema";

const posts = await getPosts();
const crumbs = [{ label: "Home", href: "/" }, { label: "Topics" }];
---

<BaseLayout
  title="Topics"
  description="Every topic in the journal, with the posts behind each."
  structuredData={withBreadcrumbs({ "@type": "CollectionPage", name: "Topics" }, crumbs)}
>
  <PageHeader
    title="Topics"
    lead={posts.length ? "Posts grouped by topic." : "No posts yet."}
    crumbs={crumbs}
  />
  <SectionIndex counts={countBy(posts, "category")} />
</BaseLayout>
