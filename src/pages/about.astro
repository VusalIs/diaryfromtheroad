---
import { Image } from "astro:assets";
import aboutImage from "@/assets/about.jpg";
import Avatar from "@/components/blog/Avatar.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { authors } from "@/config/authors";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { authorUrl } from "@/lib/posts";
import { withBreadcrumbs } from "@/lib/schema";

const crumbs = [{ label: "Home", href: "/" }, { label: "About" }];
const principles = [
  {
    title: "Published when ready",
    text: "No schedule to feed. A piece goes out when it has been written, rewritten, and read aloud.",
  },
  {
    title: "Nothing in the way",
    text: "No trackers, pop-ups, or infinite scroll. Just sentences, photographs, and room to think.",
  },
  {
    title: "Independent",
    text: "Unsponsored and reader-supported, so the only people we answer to are the ones reading.",
  },
];
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.name}: an independent magazine on writing, design, and the slow web.`}
  structuredData={withBreadcrumbs(
    { "@type": "AboutPage", name: `About ${siteConfig.name}` },
    crumbs,
  )}
>
  <PageHeader title="A quiet magazine for the open web." crumbs={crumbs} />

  <div class="shell grid grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[1fr_minmax(0,37rem)] lg:gap-20">
    <div class="relative">
      <div class="media aspect-[16/10] shadow-[var(--shadow-card)] lg:absolute lg:inset-0 lg:aspect-auto">
        <Image
          src={aboutImage}
          alt="Shelves of books in a quiet, sunlit library reading room."
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 64rem) 30rem, 92vw"
          quality={72}
          class="object-[70%_50%]"
        />
      </div>
    </div>
    <div class="prose-article">
      <p>
        {siteConfig.name} began as a folder of notes, drafts, and half-finished essays, the kind of
        writing that doesn't survive the timeline. We started publishing it here because we wanted
        somewhere slower to read, and somewhere slower to write.
      </p>
      <p>
        The magazine is independent, occasional, and unsponsored. We publish when the work is ready
        and not before.
      </p>
      <h2 id="what-we-publish">What we publish</h2>
      <p>
        Essays on writing, design, and the craft of the web. Field notes from places we love.
        Interviews with people who make things with their hands. The occasional photograph, when one
        is worth printing.
      </p>
    </div>
  </div>

  <section class="shell mt-24" aria-labelledby="principles-title">
    <h2 id="principles-title" class="serif text-section font-normal">
      How we work
    </h2>
    <ol class="mt-10 grid gap-10 md:grid-cols-3 md:gap-12">
      {principles.map((item, index) => (
        <li>
          <span class="text-sm tabular-nums text-muted">0{index + 1}</span>
          <h3 class="serif mt-3 text-title font-medium">{item.title}</h3>
          <p class="mt-3 leading-relaxed text-body">{item.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <div class="shell mt-20">
    <hr class="border-line" />
  </div>

  <section class="shell mt-20" aria-labelledby="team-title">
    <h2 id="team-title" class="serif text-section font-normal">
      Who we are
    </h2>
    <ul class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {authors.map((author) => (
        <li>
          <a href={authorUrl(author.slug)} class="group flex items-center gap-4">
            <Avatar author={author} size={64} />
            <span>
              <span class="serif block text-xl">
                <span class="card-title">{author.name}</span>
              </span>
              <span class="mt-0.5 block text-sm text-muted">{author.role}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
