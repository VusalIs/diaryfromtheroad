---
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";
import SubscribeForm from "@/components/blog/SubscribeForm.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBreadcrumbs } from "@/lib/schema";
import { formSiteKey } from "@/lib/subscriptions";

const crumbs = [{ label: "Home", href: "/" }, { label: "About" }];
/* The weekly-map sign-up, once it is configured and enabled (SUBSCRIPTIONS.md). */
const subscribeSiteKey = formSiteKey({
  siteKey: PUBLIC_TURNSTILE_SITE_KEY,
  production: import.meta.env.PROD,
  enabled: siteConfig.subscriptions.enabled,
  siteUrl: siteConfig.siteUrl,
});
---

<BaseLayout
  title="About"
  description={`Who writes ${siteConfig.name}, and what it covers: remote work, travel in Southeast Asia, real costs, motorcycles, and building software.`}
  structuredData={withBreadcrumbs(
    { "@type": "AboutPage", name: `About ${siteConfig.name}` },
    crumbs,
  )}
>
  <PageHeader
    title="About"
    lead="I'm Vusal, a software developer from Azerbaijan. I work remotely, and for now I'm based in Hanoi while I travel around Southeast Asia."
    crumbs={crumbs}
  />

  <div class="shell">
    <div class="max-w-[37rem]">
      <div class="prose-article">
        <p>
          {siteConfig.name} is where I write down what that actually looks like: where I go, how I
          get around, what things cost, and what I'm building alongside my job.
        </p>
        <p>
          I'm not doing this on a big budget. I earn an ordinary remote salary, and part of the
          point is to find out how far it goes: which places are worth spending time in, what
          everyday life really costs, and what there is to see and do beyond the usual tourist
          route. I'm working that out as I go, not writing as someone who already knows.
        </p>

        <h2>What I write about</h2>
        <ul>
          <li>
            <strong>Places worth discovering.</strong> Interesting experiences, places that are easy
            to miss, and trips by motorcycle.
          </li>
          <li>
            <strong>The real cost of life on the road.</strong> Spending breakdowns for
            accommodation, food, and transport, and the trade-offs behind them.
          </li>
          <li>
            <strong>Working remotely.</strong> What it's like to do a regular job while living
            somewhere new.
          </li>
          <li>
            <strong>Things I'm building.</strong> Software and small projects outside my job, which
            I hope will earn something beyond my salary one day, including the ones that don't work
            out.
          </li>
        </ul>

        <p>
          If you're planning a trip to Southeast Asia, you might find realistic numbers here and a
          few places worth adding to your list. If you work remotely, you might get a sense of what
          your own job could make possible. Or you might just like reading an honest account of
          someone testing how far their circumstances stretch. My situation won't match yours
          exactly, so not everything here will apply to you.
        </p>
        <p>
          I'd rather write things down as they happen, numbers and loose ends included, than wait
          until everything looks tidy.
        </p>
        {subscribeSiteKey && (
          <p>
            I'm also starting a weekly map of places I come across, as a list you can save in Google
            Maps. The <a href="#subscribe-title">sign-up</a> is at the bottom of this page.
          </p>
        )}
        <p>
          If you want to say hello, my <a href="/contact/">contact page</a> has the links.
        </p>
      </div>
      {subscribeSiteKey && <SubscribeForm siteKey={subscribeSiteKey} />}
    </div>
  </div>
</BaseLayout>
