---
import PageHeader from "@/components/ui/PageHeader.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBreadcrumbs } from "@/lib/schema";

const crumbs = [{ label: "Home", href: "/" }, { label: "About" }];
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.name}. ${siteConfig.description}`}
  structuredData={withBreadcrumbs(
    { "@type": "AboutPage", name: `About ${siteConfig.name}` },
    crumbs,
  )}
>
  {/* TODO: add the About text in your own words, below the header, using the prose-article style. */}
  <PageHeader title="About" lead={siteConfig.description} crumbs={crumbs} />
</BaseLayout>
