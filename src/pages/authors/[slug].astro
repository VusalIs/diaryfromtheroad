---
import Avatar from "@/components/blog/Avatar.astro";
import Breadcrumbs from "@/components/blog/Breadcrumbs.astro";
import PostGrid from "@/components/blog/PostGrid.astro";
import { authors, type Author } from "@/config/authors";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { authorUrl, getPosts, plural } from "@/lib/posts";
import { absolute, withBreadcrumbs } from "@/lib/schema";

export function getStaticPaths() {
  return authors.map((author) => ({ params: { slug: author.slug }, props: { author } }));
}

interface Props {
  author: Author;
}

const { author } = Astro.props;
const posts = (await getPosts()).filter((post) => post.author === author.slug);
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Contributors", href: "/authors/" },
  { label: author.name },
];
---

<BaseLayout
  title={author.name}
  description={author.bio}
  image={author.avatar}
  imageAlt={`Portrait of ${author.name}`}
  type="profile"
  structuredData={withBreadcrumbs(
    {
      "@type": "ProfilePage",
      mainEntity: {
        "@type": "Person",
        name: author.name,
        jobTitle: author.role,
        description: author.longBio,
        url: absolute(authorUrl(author.slug)),
      },
    },
    crumbs,
  )}
>
  <header>
    <div class="shell pb-14 pt-14 sm:pb-20 sm:pt-20">
      <Breadcrumbs items={crumbs} class="rise" />
      <div class="mt-10 flex flex-col gap-8 sm:flex-row sm:items-center">
        <Avatar author={author} size={128} class="rise shadow-[var(--shadow-card)]" />
        <div class="rise" style="--rise-order: 1">
          <h1 class="serif text-headline font-normal">{author.name}</h1>
          <p class="mt-2 text-muted">
            {author.role} &middot; {plural(posts.length, "piece")}
          </p>
        </div>
      </div>
      <p class="serif rise mt-8 max-w-xl text-lead text-body" style="--rise-order: 2">
        {author.longBio}
      </p>
    </div>
  </header>

  {posts.length > 0 ? (
    <PostGrid posts={posts} />
  ) : (
    <p class="shell text-muted">Nothing published yet. Check back soon.</p>
  )}
</BaseLayout>
