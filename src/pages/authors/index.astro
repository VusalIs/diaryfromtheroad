---
import Avatar from "@/components/blog/Avatar.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { authors } from "@/config/authors";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { authorUrl, countBy, getPosts, plural } from "@/lib/posts";
import { withBreadcrumbs } from "@/lib/schema";

const counts = countBy(await getPosts(), "author");
const crumbs = [{ label: "Home", href: "/" }, { label: "Contributors" }];
---

<BaseLayout
  title="Contributors"
  description="The writers, editors, and photographers behind the magazine."
  structuredData={withBreadcrumbs({ "@type": "CollectionPage", name: "Contributors" }, crumbs)}
>
  <PageHeader
    title="Contributors"
    lead="A small group of writers, editors, and photographers, scattered across three time zones."
    crumbs={crumbs}
  />
  <ul class="shell grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {authors.map((author) => (
      <li>
        <a
          href={authorUrl(author.slug)}
          class="group flex h-full flex-col rounded-card border border-line bg-surface p-7 transition-[border-color,box-shadow] duration-300 hover:border-line-strong hover:shadow-[var(--shadow-card)]"
        >
          <Avatar author={author} size={72} />
          <h2 class="serif mt-6 text-title font-medium">
            <span class="card-title">{author.name}</span>
          </h2>
          <p class="mt-1 text-sm text-muted">{author.role}</p>
          <p class="serif mt-4 flex-1 text-[1.0625rem] leading-normal text-body">{author.bio}</p>
          <p class="mt-6 text-sm text-muted">{plural(counts[author.slug] ?? 0, "piece")}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
