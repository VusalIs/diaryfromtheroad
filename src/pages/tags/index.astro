---
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { tags } from "@/config/taxonomy";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, tagUrl } from "@/lib/posts";
import { withBreadcrumbs } from "@/lib/schema";

const posts = await getPosts();
const used = tags
  .map((tag) => ({
    ...tag,
    count: posts.filter((post) => (post.tags as readonly string[]).includes(tag.slug)).length,
  }))
  .filter((tag) => tag.count > 0)
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const crumbs = [{ label: "Home", href: "/" }, { label: "Tags" }];
---

<BaseLayout
  title="Tags"
  description="Every tag in the magazine, with the number of pieces behind each."
  structuredData={withBreadcrumbs({ "@type": "CollectionPage", name: "Tags" }, crumbs)}
>
  <PageHeader title="Tags" lead="Threads that run across sections." crumbs={crumbs} />
  <div class="shell">
    <ul class="flex max-w-4xl flex-wrap gap-3">
      {used.map((tag) => (
        <li>
          <a href={tagUrl(tag.slug)} class="chip min-h-11 px-5 text-[0.9375rem]">
            <Icon name="hash" class="size-4 opacity-50" />
            {tag.name}
            <span class="ml-1 text-xs tabular-nums text-muted">{tag.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
