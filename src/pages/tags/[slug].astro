---
import PostGrid from "@/components/blog/PostGrid.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { tags, type Term } from "@/config/taxonomy";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, plural } from "@/lib/posts";
import { withBreadcrumbs } from "@/lib/schema";

const hasTag = (tags: readonly string[], slug: string) => tags.includes(slug);

export async function getStaticPaths() {
  const posts = await getPosts();
  return tags
    .filter((tag) => posts.some((post) => (post.tags as readonly string[]).includes(tag.slug)))
    .map((tag) => ({ params: { slug: tag.slug }, props: { tag } }));
}

interface Props {
  tag: Term;
}

const { tag } = Astro.props;
const posts = (await getPosts()).filter((post) => hasTag(post.tags, tag.slug));
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Tags", href: "/tags/" },
  { label: tag.name },
];
---

<BaseLayout
  title={`Posts tagged ${tag.name}`}
  description={`${plural(posts.length, "post")} tagged ${tag.name}.`}
  structuredData={withBreadcrumbs({ "@type": "CollectionPage", name: tag.name }, crumbs)}
>
  <PageHeader
    title={tag.name}
    lead={`${plural(posts.length, "post")} tagged ${tag.name}.`}
    crumbs={crumbs}
  />
  <PostGrid posts={posts} />
</BaseLayout>
