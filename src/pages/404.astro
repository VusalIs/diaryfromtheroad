---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found."
  noindex
  subscribe={false}
>
  <section>
    <div class="shell flex min-h-[70svh] flex-col items-center justify-center py-24 text-center">
      <p class="text-sm tabular-nums text-muted">404</p>
      <h1 class="serif mt-4 text-headline font-normal">Lost in the margins.</h1>
      <p class="serif mt-5 max-w-lg text-lead text-body">
        The page you're looking for has wandered off. It may have moved, been retitled, or never
        existed.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">
          Back to the front page
        </a>
        <a href="/blog/" class="btn btn-quiet" data-search-open>
          Search the archive
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
