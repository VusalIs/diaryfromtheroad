---
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";
import SubscribeForm from "@/components/blog/SubscribeForm.astro";
import AppList from "@/components/home/AppList.astro";
import Hero from "@/components/home/Hero.astro";
import LatestPosts from "@/components/home/LatestPosts.astro";
import LeadStory from "@/components/home/LeadStory.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getApps } from "@/lib/apps";
import { getLeadPost, getPosts } from "@/lib/posts";
import { formSiteKey } from "@/lib/subscriptions";

const posts = await getPosts();
const lead = await getLeadPost();
const rest = posts.filter((post) => post.slug !== lead?.slug);
const apps = await getApps();
/* The weekly-map sign-up, once it is configured and enabled (SUBSCRIPTIONS.md). */
const subscribeSiteKey = formSiteKey({
  siteKey: PUBLIC_TURNSTILE_SITE_KEY,
  production: import.meta.env.PROD,
  enabled: siteConfig.subscriptions.enabled,
  siteUrl: siteConfig.siteUrl,
});
---

<BaseLayout>
  <Hero />
  {lead && <LeadStory post={lead} />}
  {rest.length > 0 && <LatestPosts posts={rest} />}
  {apps.length > 0 && <AppList apps={apps} />}
  {/* Last, after the journal itself: the blog comes first, the weekly map second. */}
  {subscribeSiteKey && (
    <div class="shell mt-16 sm:mt-24">
      <div class="max-w-[37rem]">
        <SubscribeForm siteKey={subscribeSiteKey} />
      </div>
    </div>
  )}
</BaseLayout>
