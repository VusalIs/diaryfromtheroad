---
import PageHeader from "@/components/ui/PageHeader.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBreadcrumbs } from "@/lib/schema";

const crumbs = [{ label: "Home", href: "/" }, { label: "Privacy" }];
---

<BaseLayout
  title="Privacy"
  description={`What ${siteConfig.name} does with information about visitors: no accounts, analytics, or cookies of its own, and hosting on Cloudflare.`}
  structuredData={withBreadcrumbs({ "@type": "WebPage", name: "Privacy" }, crumbs)}
>
  <PageHeader
    title="Privacy."
    lead="What this site does with information about you, as it works today."
    crumbs={crumbs}
  />

  <div class="shell">
    <div class="prose-article max-w-[37rem]">
      <h2>What the site keeps</h2>
      <p>
        There are no accounts, comments, contact forms, or email sign-ups, and the site runs no
        analytics or advertising scripts. Its own code doesn't set cookies.
      </p>
      <p>
        The one thing it saves is your choice of light or dark mode, if you use the switch in the
        header. That choice stays in your browser's local storage and isn't sent anywhere.
      </p>

      <h2>Hosting</h2>
      <p>
        The site is hosted on <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare</a>. To
        deliver the pages, Cloudflare handles the requests your browser makes, including your IP
        address, under its own privacy policy.
      </p>

      <h2>Search</h2>
      <p>
        Search runs in your browser: it loads a list of posts from this site, and what you type
        isn't sent anywhere as you search.
      </p>

      <h2>Links to other sites</h2>
      <p>
        The links to Instagram, X, and Reddit, and the share buttons on posts, take you to those
        sites, which have their own privacy policies. Nothing from them loads here unless you click.
      </p>

      <h2>Email subscriptions</h2>
      <p>
        There's no email sign-up at the moment. If I add one, this page will explain what it stores
        and how to unsubscribe before it goes live.
      </p>

      <h2>Questions</h2>
      <p>
        If you have a question about any of this, <a href="/contact/">contact me</a>.
      </p>
    </div>
  </div>
</BaseLayout>
