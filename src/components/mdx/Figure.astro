---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { lightboxRendition } from "@/lib/images";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  creditUrl?: string;
  /** `wide` breaks out of the reading column on large screens. */
  width?: "regular" | "wide";
}

const { src, alt, caption, credit, creditUrl, width = "regular" } = Astro.props;
const full = await lightboxRendition(src);
const sizes =
  width === "wide" ? "(min-width: 64rem) 56rem, 92vw" : "(min-width: 48rem) 37rem, 92vw";
---

<figure class:list={["figure", width === "wide" && "figure-wide"]}>
  <button
    type="button"
    class="figure-frame"
    data-lightbox
    data-lightbox-src={full.src}
    data-lightbox-srcset={full.srcSet.attribute}
    data-lightbox-alt={alt}
    data-lightbox-caption={[caption, credit].filter(Boolean).join(" ")}
    aria-label={`Enlarge image: ${alt}`}
  >
    <Image src={src} alt={alt} widths={[640, 960, 1280, 1800]} sizes={sizes} quality={78} />
  </button>
  {(caption || credit) && (
    <figcaption>
      {caption}
      {caption && credit && " "}
      {credit &&
        (creditUrl ? (
          <a href={creditUrl} rel="noopener noreferrer">
            {credit}
          </a>
        ) : (
          credit
        ))}
    </figcaption>
  )}
</figure>
