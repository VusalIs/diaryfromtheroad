---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import { categoryUrl, formatDate, getCategory, isoDate, postUrl, type Post } from "@/lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const category = getCategory(post.category);
---

<section class="shell mt-12 sm:mt-20" aria-label={post.featured ? "Featured post" : "Latest post"}>
  <article class="group relative grid items-center gap-8 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
    <div class="media aspect-[4/3] shadow-[var(--shadow-card)]">
      <Image
        src={post.thumbnail}
        alt=""
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 64rem) 40rem, 92vw"
        quality={76}
      />
    </div>
    <div>
      <div class="meta">
        {category && (
          <a href={categoryUrl(category.slug)} class="relative z-10">
            {category.name}
          </a>
        )}
        <time datetime={isoDate(post.date)}>{formatDate(post.date)}</time>
        <span>{post.readingTime} min read</span>
      </div>
      <h2 class="serif mt-4 text-[clamp(2rem,1.4rem+2.2vw,3.25rem)] leading-[1.1] font-normal tracking-[-0.01em]">
        <a href={postUrl(post)} class="card-title after:absolute after:inset-0 after:content-['']">
          {post.title}
        </a>
      </h2>
      <p class="serif mt-5 text-lead text-body">{post.excerpt}</p>
      <span class="mt-8 inline-flex items-center gap-2 text-sm font-medium" aria-hidden="true">
        Read the post
        <span class="grid size-9 place-items-center rounded-full border border-line-strong transition-colors duration-300 group-hover:border-ink group-hover:bg-ink group-hover:text-canvas">
          <Icon name="arrow-right" class="size-4" />
        </span>
      </span>
    </div>
  </article>
</section>
