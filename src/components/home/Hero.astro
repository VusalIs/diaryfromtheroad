---
import { Image } from "astro:assets";
import heroImage from "@/assets/hero-mist.jpg";
import Icon from "@/components/ui/Icon.astro";
import { homeConfig } from "@/config/home";
import { postUrl, type Post } from "@/lib/posts";

interface Props {
  lead: Post;
}

const { lead } = Astro.props;
const { hero } = homeConfig;
const parts = hero.title.split(/(\*[^*]+\*)/).filter(Boolean);
---

<section class="relative isolate -mt-(--header-h) flex min-h-[min(100svh,58rem)] flex-col overflow-hidden pt-(--header-h)">
  <Image
    src={heroImage}
    alt=""
    widths={[640, 960, 1280, 1920, 2600]}
    sizes="100vw"
    quality={72}
    loading="eager"
    fetchpriority="high"
    class="hero-image absolute inset-0 -z-10 size-full object-cover object-bottom"
  />
  <div class="hero-shade absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="shell flex flex-col items-center pt-14 text-center sm:pt-20 lg:pt-24">
    <h1 class="serif rise max-w-5xl text-display font-light">
      {parts.map((part) =>
        part.startsWith("*") ? <em class="italic">{part.slice(1, -1)}</em> : part,
      )}
    </h1>
    <p class="serif rise mt-7 max-w-xl text-lead text-body" style="--rise-order: 1">
      {hero.lead}
    </p>
    <div
      class="rise mt-10 flex flex-wrap items-center justify-center gap-3"
      style="--rise-order: 2"
    >
      <a href={postUrl(lead)} class="btn btn-primary group">
        {hero.primary.label}
        <Icon
          name="arrow-right"
          class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
        />
      </a>
      <a href={hero.secondary.href} class="btn btn-quiet">
        {hero.secondary.label}
      </a>
    </div>
  </div>
</section>

<style>
  /* The photograph's mist matches the canvas, so the type sits in it; the shade keeps that
     true on narrow screens, where the hills climb higher. */
  .hero-shade {
    background: linear-gradient(
      to bottom,
      var(--canvas) 0%,
      color-mix(in oklab, var(--canvas) 92%, transparent) 42%,
      color-mix(in oklab, var(--canvas) 62%, transparent) 60%,
      transparent 82%
    );
  }

  :global(.dark) .hero-image {
    filter: brightness(0.62) saturate(1.1);
  }

  :global(.dark) .hero-shade {
    background: linear-gradient(
      to bottom,
      var(--canvas) 0%,
      color-mix(in oklab, var(--canvas) 82%, transparent) 42%,
      color-mix(in oklab, var(--canvas) 30%, transparent) 100%
    );
  }
</style>
