---
import Icon from "@/components/ui/Icon.astro";
import { homeConfig } from "@/config/home";
import { siteConfig } from "@/config/site";

const { hero } = homeConfig;
---

<section class="shell flex flex-col items-center pt-12 text-center sm:pt-16 lg:pt-20">
  <h1 class="serif rise max-w-5xl text-display font-light">{siteConfig.name}</h1>
  <p class="serif rise mt-6 max-w-xl text-lead text-body" style="--rise-order: 1">
    {hero.lead}
  </p>
  <a
    href={hero.link.href}
    class="rise group mt-5 inline-flex min-h-11 items-center gap-1.5 text-sm font-medium"
    style="--rise-order: 2"
  >
    {hero.link.label}
    <Icon
      name="arrow-right"
      class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
    />
  </a>
</section>
