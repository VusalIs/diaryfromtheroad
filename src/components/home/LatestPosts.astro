---
import PostCard from "@/components/blog/PostCard.astro";
import Icon from "@/components/ui/Icon.astro";
import { homeConfig } from "@/config/home";
import { categories } from "@/config/taxonomy";
import type { Post } from "@/lib/posts";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const { title, count } = homeConfig.latest;
/* A filter only earns its place once there are more posts than the grid shows. */
const filters =
  posts.length > count
    ? categories.filter((category) => posts.some((post) => post.category === category.slug))
    : [];
/* One or two cards share the row in halves rather than leaving a third of it empty. */
const wide = posts.length <= 2;
---

<section class="shell mt-28 sm:mt-36" aria-labelledby="latest-title" data-latest data-count={count}>
  <div class="flex flex-wrap items-end justify-between gap-6">
    <h2 id="latest-title" class="serif text-section font-normal">
      {title}
    </h2>
    <a href="/blog/" class="group inline-flex items-center gap-1.5 text-sm font-medium">
      All posts
      <Icon
        name="arrow-right"
        class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
      />
    </a>
  </div>

  {filters.length > 0 && (
    <div class="segmented mt-8" role="group" aria-label="Filter by topic" data-needs-js>
      <button type="button" aria-pressed="true" data-filter="">
        All
      </button>
      {filters.map((category) => (
        <button type="button" aria-pressed="false" data-filter={category.slug}>
          {category.name}
        </button>
      ))}
    </div>
  )}

  <div class:list={["mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2", !wide && "lg:grid-cols-3"]}>
    {posts.map((post, index) => (
      <PostCard post={post} hidden={index >= count} wide={wide} />
    ))}
  </div>
  <p class="sr-only" aria-live="polite" data-latest-status></p>
</section>

<script>
  const section = document.querySelector<HTMLElement>("[data-latest]");
  if (section) {
    const limit = Number(section.dataset.count) || 6;
    const buttons = [...section.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const cards = [...section.querySelectorAll<HTMLElement>("[data-post-card]")];
    const status = section.querySelector<HTMLElement>("[data-latest-status]");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter ?? "";
        let shown = 0;
        cards.forEach((card) => {
          const match = !filter || card.dataset.category === filter;
          card.hidden = !(match && shown < limit);
          if (match && shown < limit) shown += 1;
        });
        buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        if (status) status.textContent = `${shown} ${shown === 1 ? "post" : "posts"} shown`;
      });
    });
  }
</script>
