---
import Icon from "@/components/ui/Icon.astro";
import { categories } from "@/config/taxonomy";
import { categoryUrl, plural } from "@/lib/posts";

interface Props {
  counts: Record<string, number>;
}

const { counts } = Astro.props;
const sections = categories.filter((category) => counts[category.slug]);
---

{sections.length > 0 && (
  <section class="shell" aria-label="Topics">
    <ul class="border-b border-line">
      {sections.map((category) => (
        <li class="border-t border-line">
          <a href={categoryUrl(category.slug)} class="group flex items-center gap-6 py-7">
            <span class="min-w-0 flex-1">
              <span class="serif block text-[1.75rem] leading-tight tracking-[-0.012em] transition-colors group-hover:text-accent">
                {category.name}
              </span>
              <span class="mt-1.5 block text-muted">{category.description}</span>
            </span>
            <span class="hidden shrink-0 text-sm text-muted sm:block">
              {plural(counts[category.slug], "post")}
            </span>
            <span class="grid size-10 shrink-0 place-items-center rounded-full border border-line-strong transition-colors duration-300 group-hover:border-ink group-hover:bg-ink group-hover:text-canvas">
              <Icon name="arrow-right" class="size-4" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
