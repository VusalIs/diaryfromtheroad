---
import Icon from "@/components/ui/Icon.astro";
import { footerLinks, siteConfig } from "@/config/site";
import { categories } from "@/config/taxonomy";
import { categoryUrl, getPosts } from "@/lib/posts";

const year = new Date().getFullYear();
const posts = await getPosts();
const sections = categories.filter((category) =>
  posts.some((post) => post.category === category.slug),
);
---

<footer class="mt-24 border-t border-line sm:mt-32">
  <div class="shell grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <a href="/" class="serif rounded-lg text-[1.5rem] font-medium tracking-[-0.01em]">
        {siteConfig.name}
      </a>
      <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted">{siteConfig.description}</p>
      {(siteConfig.socials.length > 0 || siteConfig.email) && (
        <ul class="mt-6 flex items-center gap-1">
          {siteConfig.socials.map((social) => (
            <li>
              <a
                href={social.href}
                class="icon-btn"
                aria-label={`${siteConfig.name} on ${social.label}`}
              >
                <Icon name={`social-${social.icon}`} class="size-[1.05rem]" />
              </a>
            </li>
          ))}
          {siteConfig.email && (
            <li>
              <a href={`mailto:${siteConfig.email}`} class="icon-btn" aria-label="Send an email">
                <Icon name="mail" class="size-[1.05rem]" />
              </a>
            </li>
          )}
        </ul>
      )}
    </div>

    {sections.length > 0 && (
      <nav aria-labelledby="footer-topics">
        <h2 id="footer-topics" class="text-sm font-medium">
          Topics
        </h2>
        <ul class="mt-4 space-y-2.5">
          {sections.map((category) => (
            <li>
              <a href={categoryUrl(category.slug)} class="footer-link">
                {category.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <nav aria-labelledby="footer-journal">
      <h2 id="footer-journal" class="text-sm font-medium">
        The journal
      </h2>
      <ul class="mt-4 space-y-2.5">
        {footerLinks.map((link) => (
          <li>
            <a href={link.href} class="footer-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="shell">
    <div class="flex flex-col gap-2 border-t border-line py-7 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>
        &copy; {year} {siteConfig.name}.
      </p>
      <p>Set in Newsreader and Geist.</p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    font-size: 0.9375rem;
    color: var(--muted);
    transition: color 200ms ease;
  }

  .footer-link:hover {
    color: var(--ink);
  }
</style>
