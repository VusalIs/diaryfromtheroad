---
import { subscribeConfig } from "@/config/home";
import { siteConfig } from "@/config/site";

const endpoint = siteConfig.forms.newsletter;
---

<section id="subscribe" class="shell mt-24 sm:mt-32" aria-labelledby="subscribe-title">
  <div class="relative isolate overflow-hidden rounded-panel border border-line bg-surface px-6 py-16 text-center sm:px-12 sm:py-24">
    <h2 id="subscribe-title" class="serif text-section font-normal">
      {subscribeConfig.title}
    </h2>
    <p class="serif mx-auto mt-4 max-w-xl text-lead text-body">{subscribeConfig.lead}</p>

    <form
      class="mx-auto mt-9 max-w-md"
      method="post"
      action={endpoint || undefined}
      data-demo-form={endpoint ? undefined : ""}
      data-needs-js={endpoint ? undefined : ""}
      data-success="Thanks. You're on the list (demo mode: set an endpoint in src/config/site.ts to collect sign-ups)."
    >
      <div class="flex flex-col gap-2 rounded-[1.5rem] border border-line-strong bg-surface p-1.5 shadow-[var(--shadow-card)] transition-colors focus-within:border-accent sm:flex-row sm:rounded-full">
        <label for="subscribe-email" class="sr-only">
          Email address
        </label>
        <input
          id="subscribe-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="min-h-11 min-w-0 flex-1 rounded-full bg-transparent px-4 text-base outline-none placeholder:text-muted"
        />
        <button type="submit" class="btn btn-primary">
          {subscribeConfig.button}
        </button>
      </div>
      <p class="mt-4 min-h-6 text-sm text-muted" data-form-status role="status">
        {subscribeConfig.note}
      </p>
    </form>
  </div>
</section>

<script>
  import "@/scripts/forms";
</script>
