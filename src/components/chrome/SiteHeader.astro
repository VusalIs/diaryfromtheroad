---
import ThemeToggle from "@/components/chrome/ThemeToggle.astro";
import Icon from "@/components/ui/Icon.astro";
import { navigation, siteConfig } from "@/config/site";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="shell flex h-(--header-h) items-center gap-4">
    <a
      href="/"
      class="serif mr-auto rounded-lg text-[1.25rem] leading-tight font-medium tracking-[-0.01em] min-[360px]:whitespace-nowrap sm:text-[1.5rem]"
    >
      {siteConfig.name}
    </a>

    <nav class="hidden md:block" aria-label="Primary">
      <ul class="flex items-center gap-1">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link"
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1 md:ml-4">
      <a href="/blog/" class="search-trigger" data-search-open aria-label="Search">
        <Icon name="search" class="size-4" />
        <span class="hidden lg:inline">Search</span>
        <kbd data-needs-js>/</kbd>
      </a>
      <ThemeToggle />
      <a
        href="/rss.xml"
        class="ml-1 hidden min-h-10 items-center gap-1.5 rounded-full px-3 text-[0.9375rem] text-muted transition-colors hover:text-ink sm:inline-flex"
      >
        <Icon name="rss" class="size-4" />
        RSS
      </a>
      <button
        type="button"
        class="icon-btn md:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="menu" class="menu-icon-open size-5" />
        <Icon name="x" class="menu-icon-close hidden size-5" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu md:hidden" hidden data-menu>
    <nav class="shell pb-8 pt-2" aria-label="Mobile">
      <ul class="divide-y divide-line border-y border-line">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class="serif flex items-center justify-between py-4 text-2xl"
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
              <Icon name="arrow-right" class="size-5 text-muted" />
            </a>
          </li>
        ))}
      </ul>
      <a href="/rss.xml" class="mt-6 inline-flex min-h-11 items-center gap-2 font-medium">
        <Icon name="rss" class="size-4" />
        RSS feed
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition:
      transform 400ms var(--ease-out-expo),
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  /* A shadow, not a border, so the header stays exactly --header-h tall over the hero. */
  .site-header[data-scrolled],
  .site-header[data-open] {
    background: var(--canvas);
    box-shadow: 0 1px 0 var(--line);
  }

  .site-header[data-hidden] {
    transform: translateY(-100%);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    border-radius: 999px;
    padding: 0 0.85rem;
    font-size: 0.9375rem;
    color: var(--muted);
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link[aria-current="page"] {
    background: color-mix(in oklab, var(--ink) 6%, transparent);
    color: var(--ink);
    font-weight: 500;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.875rem;
    transition:
      color 200ms ease,
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .search-trigger:hover {
    background: var(--sunken);
    color: var(--ink);
  }

  @media (min-width: 64rem) {
    .search-trigger {
      border: 1px solid var(--line-strong);
      background: color-mix(in oklab, var(--surface) 60%, transparent);
      padding: 0 0.5rem 0 0.85rem;
      margin-right: 0.25rem;
    }

    .search-trigger:hover {
      border-color: var(--ink);
      background: var(--surface);
    }
  }

  .search-trigger kbd {
    display: none;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    margin-left: 0.75rem;
    border-radius: 0.4rem;
    background: var(--sunken);
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  @media (min-width: 64rem) {
    .search-trigger kbd {
      display: inline-grid;
    }
  }

  .mobile-menu {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    height: calc(100svh - var(--header-h));
    overflow-y: auto;
    background: var(--canvas);
  }

  .site-header[data-open] :global(.menu-icon-open) {
    display: none;
  }

  .site-header[data-open] :global(.menu-icon-close) {
    display: inline-grid;
  }

  .mobile-menu [aria-current="page"] {
    color: var(--accent);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  let lastY = window.scrollY;

  /* Hides on the way down, returns solid on the way up. */
  const sync = () => {
    if (!header) return;
    const y = Math.max(0, window.scrollY);
    const open = header.hasAttribute("data-open");
    const pastHeader = y > header.offsetHeight;
    if (!open && pastHeader && y > lastY + 2) header.setAttribute("data-hidden", "");
    else if (y < lastY - 2 || !pastHeader || open) header.removeAttribute("data-hidden");
    lastY = y;

    header.toggleAttribute("data-scrolled", y > 8);
  };

  sync();
  window.addEventListener("scroll", sync, { passive: true });
  header?.addEventListener("focusin", () => header.removeAttribute("data-hidden"));

  if (header && toggle && menu) {
    const setOpen = (open: boolean, restoreFocus = false) => {
      menu.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      header.toggleAttribute("data-open", open);
      sync();
      document.documentElement.style.overflow = open ? "hidden" : "";
      if (!open && restoreFocus) toggle.focus();
    };

    toggle.addEventListener("click", () => setOpen(menu.hidden === true));
    menu.querySelectorAll("[data-menu-close]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) setOpen(false, true);
    });
    window.matchMedia("(min-width: 48rem)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
