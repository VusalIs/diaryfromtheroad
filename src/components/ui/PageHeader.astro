---
import Breadcrumbs from "@/components/blog/Breadcrumbs.astro";
import type { Crumb } from "@/lib/schema";

interface Props {
  title: string;
  lead?: string;
  crumbs?: Crumb[];
}

const { title, lead, crumbs } = Astro.props;
---

<header>
  <div class="shell pb-14 pt-14 sm:pb-20 sm:pt-20">
    {crumbs && <Breadcrumbs items={crumbs} class="rise" />}
    <h1 class="serif rise mt-5 max-w-4xl text-headline font-normal" style="--rise-order: 1">
      {title}
    </h1>
    {lead && (
      <p class="serif rise mt-5 max-w-xl text-lead text-body" style="--rise-order: 2">
        {lead}
      </p>
    )}
    <slot />
  </div>
</header>
