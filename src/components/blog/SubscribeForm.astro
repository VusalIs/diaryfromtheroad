---
import SubscribeFields from "@/components/blog/SubscribeFields.astro";

/* Sign-up for the weekly map email, at the end of each article (see SUBSCRIPTIONS.md). Hidden
   without JavaScript, which the spam check needs. */
interface Props {
  /** The Turnstile site key. */
  siteKey: string;
}

const { siteKey } = Astro.props;
---

<section class="mt-10 border-t border-line pt-8" aria-labelledby="subscribe-title" data-needs-js>
  <h2 id="subscribe-title" class="serif text-2xl">
    Get the weekly map
  </h2>
  <p class="mt-2 text-muted">
    One email a week with a Google Maps list of places I've found worth the trip, wherever I am:
    views, cafés to work from, cheap local food, and good detours. For new posts, there's the{" "}
    <a href="/rss.xml" class="text-link">
      RSS feed
    </a>
    .
  </p>
  <div class="mt-6">
    <SubscribeFields siteKey={siteKey} idPrefix="subscribe" buttonLabel="Send me the map">
      Free, and every email has a link to unsubscribe.{" "}
      <a href="/privacy/" class="text-link">
        How your address is kept
      </a>
      .
    </SubscribeFields>
  </div>
</section>
