---
import Avatar from "@/components/blog/Avatar.astro";
import Icon from "@/components/ui/Icon.astro";
import type { Author } from "@/config/authors";
import { authorUrl } from "@/lib/posts";

interface Props {
  author: Author;
}

const { author } = Astro.props;
const firstName = author.name.split(" ")[0];
---

<aside
  class="flex flex-col gap-5 rounded-card bg-sunken p-6 sm:flex-row sm:p-8"
  aria-label="About the author"
>
  <Avatar author={author} size={64} />
  <div>
    <p class="serif text-[1.375rem] leading-tight">{author.name}</p>
    <p class="mt-1 text-sm text-muted">{author.role}</p>
    <p class="serif mt-3 text-[1.0625rem] leading-normal text-body">{author.longBio}</p>
    <a
      href={authorUrl(author.slug)}
      class="group mt-4 inline-flex items-center gap-1.5 text-sm font-medium"
    >
      More from {firstName}
      <Icon
        name="arrow-right"
        class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
      />
    </a>
  </div>
</aside>
