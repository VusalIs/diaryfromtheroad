---
import { Image } from "astro:assets";
import Avatar from "@/components/blog/Avatar.astro";
import {
  categoryUrl,
  formatDate,
  getAuthor,
  getCategory,
  getTag,
  isoDate,
  postUrl,
  type Post,
} from "@/lib/posts";

interface Props {
  post: Post;
  headingLevel?: 2 | 3;
  hidden?: boolean;
  /** Eager-load the image when the card sits above the fold. */
  eager?: boolean;
}

const { post, headingLevel = 3, hidden = false, eager = false } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const author = getAuthor(post.author);
const category = getCategory(post.category);
const searchable = [
  post.title,
  post.excerpt,
  category?.name,
  author?.name,
  ...post.tags.map((tag) => getTag(tag)?.name),
]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
---

<article
  class="group relative flex flex-col"
  data-post-card
  data-category={post.category}
  data-tags={post.tags.join(" ")}
  data-search={searchable}
  hidden={hidden}
>
  <div class="media aspect-[3/2]">
    <Image
      src={post.thumbnail}
      alt=""
      widths={[400, 640, 880]}
      sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 45vw, 92vw"
      quality={72}
      loading={eager ? "eager" : "lazy"}
    />
  </div>
  <div class="meta mt-5">
    {category && (
      <a href={categoryUrl(category.slug)} class="relative z-10">
        {category.name}
      </a>
    )}
    <time datetime={isoDate(post.date)}>{formatDate(post.date, "short")}</time>
  </div>
  <Heading class="serif mt-2.5 text-title font-medium">
    <a href={postUrl(post)} class="card-title after:absolute after:inset-0 after:content-['']">
      {post.title}
    </a>
  </Heading>
  <p class="serif mt-3 line-clamp-2 text-[1.0625rem] leading-normal text-muted">{post.excerpt}</p>
  {author && (
    <div class="mt-5 flex items-center gap-2.5 text-[0.8125rem] text-muted">
      <Avatar author={author} size={24} />
      <span class="text-ink">{author.name}</span>
      <span aria-hidden="true">&middot;</span>
      <span>{post.readingTime} min read</span>
    </div>
  )}
</article>
