# Copy to .env.development for `npm run dev`. Values here are read at build time and are public.
# Cloudflare's Turnstile test site key, which always passes. Production builds take the real key
# from .env.production or a build variable, and fail if sign-up is enabled with a test key; see
# SUBSCRIPTIONS.md.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
