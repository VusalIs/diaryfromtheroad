# Copy to .env.development for `npm run dev`. Values here are read at build time and are public.
# Cloudflare's Turnstile test site key, which always passes on localhost. It overrides the site's
# real key (set in astro.config.mjs), which Turnstile only accepts on diaryfromtheroad.com.
# Production builds fail if sign-up is enabled with a test key; see SUBSCRIPTIONS.md.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
